#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start the web terminal (ttyd) with EBaC running in it.
#
# Each time someone opens EBaC in the sidebar, ttyd starts a fresh copy of
# the program. When the user exits EBaC, ttyd greys the screen and offers
# "Press Enter to Reconnect", just like the Terminal app.
# ==============================================================================
bashio::log.info "Starting EBaC..."

# /data is the app's own storage, kept across restarts, updates and
# backups. Each user's search history goes in /data/users/NAME; see
# /usr/bin/ebac-session.
mkdir -p /data/users
cd /data || bashio::exit.nok "Can't find the /data folder!"

# EBaC's folder: /data/ebac, holding the translations users add (A on the
# main menu) and links to the app's own files; see /usr/bin/ebac-setup.
/usr/bin/ebac-setup || bashio::exit.nok "Can't set up /data/ebac!"
export BIBLEROOT=/data/ebac

# The troubleshooting box (what the page sees of the focus and the window's
# size: see gestures.js), if the option is on.
if bashio::config.true 'debug_overlay'; then
    bashio::log.info "Troubleshooting box on (debug_overlay)"
    export EBAC_DEBUG=true
fi

# ttyd with EBaC in it, as in EBaC's standalone image (ebac-web, shared
# with it). --auth-header: Home Assistant's ingress adds the logged-in
# user's name in X-Remote-User-Name; ttyd passes it to ebac-session as
# TTYD_USER (and refuses connections without it, which only come from
# outside ingress).
exec /usr/bin/ebac-web 8099 --auth-header X-Remote-User-Name
